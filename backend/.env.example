# Server Configuration
PORT=5001
FRONTEND_URL=http://localhost:5173

# Rate Limiting (Upstash Redis)
# Get credentials at: https://console.upstash.com/
UPSTASH_REDIS_REST_URL=https://your-upstash-redis-url.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_rest_token

# Contact Form Notifications (Resend)
# Get free API key at: https://resend.com
RESEND_API_KEY=re_your_resend_api_key
CONTACT_TO_EMAIL=your.email@example.com

# Database Storage (MongoDB Atlas)
# Get free cluster connection string at: https://www.mongodb.com/atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/portfolio?retryWrites=true&w=majority

# Resume Redirect URL (Optional fallback if not hosted statically)
RESUME_URL=/resume.pdf
